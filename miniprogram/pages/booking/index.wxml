<view class="page">
  <view class="page-head"><view class="row"><text class="page-title">预约冷库</text><text class="demo-badge">比赛演示</text></view><view class="page-sub">{{selected.name || '加载企业信息中'}} · 保底{{selected.guarantee || 0}}m³</view></view>
  <view wx:if="{{loadError}}" class="load-error"><text>{{loadError}}</text><button class="secondary compact" bindtap="refresh">重新加载</button></view>
  <view wx:if="{{sourceName}}" class="source-hint"><image class="icon" src="/assets/icons/info.png"/><view>参考库区：{{sourceName}}。已带入温区和时段，最终库区由共享池统筹分配。</view></view>
  <form bindsubmit="submit">
    <view class="form-section"><view class="form-section-title">存储需求</view><view class="choice-grid"><button class="temp-choice {{tempIndex === 0 ? 'selected' : ''}}" hover-class="press" data-index="0" bindtap="chooseTemp"><view><view class="temp-choice-title">2–8℃</view><view class="temp-choice-sub">冷藏存储</view></view><view class="selection-dot"/></button><button class="temp-choice {{tempIndex === 1 ? 'selected' : ''}}" hover-class="press" data-index="1" bindtap="chooseTemp"><view><view class="temp-choice-title">−20℃</view><view class="temp-choice-sub">冷冻存储</view></view><view class="selection-dot"/></button></view>
      <view class="form-pair"><view class="field"><text class="field-label">需求库容 / m³</text><input class="input" name="volume" data-field="volume" value="{{fields.volume}}" bindinput="input" type="digit" placeholder="填写库容"/></view><view class="field"><text class="field-label">存储天数</text><input class="input" name="days" data-field="days" value="{{fields.days}}" bindinput="input" type="number"/></view></view><view class="field"><text class="field-label">计划入库日期</text><picker mode="date" value="{{start}}" bindchange="dateChange"><view class="select-box" hover-class="tap-surface"><text>{{start}}</text><image class="icon" src="/assets/icons/calendar-active.png"/></view></picker><view class="field-hint">按自然日计算，结束日不占用库容。</view></view><view class="field"><text class="field-label">药品类别</text><input class="input" name="drug" data-field="drug" value="{{fields.drug}}" bindinput="input" maxlength="60" placeholder="例如：疫苗、蛋白原液"/></view><view class="switch-row"><view class="switch-copy"><view class="switch-label">需要独立隔离储位</view><view class="field-hint">按演示场景手动设置</view></view><switch color="#096C9C" checked="{{isolation}}" bindchange="isolationChange"/></view>
    </view>
    <view class="form-section"><view class="form-section-title">需求优先级与价格</view><view class="field"><text class="field-label">演示季节价格</text><picker range="{{seasonOptions}}" value="{{seasonIndex}}" bindchange="seasonChange"><view class="select-box"><text>{{seasonOptions[seasonIndex]}}</text><text class="select-label">选择</text></view></picker><view class="field-hint">冷藏基准3.5元／冷冻5元，每m³每天；供给企业自定义价以库区报价为准。</view></view><view class="field"><text class="field-label">紧急程度</text><picker range="{{urgencyOptions}}" value="{{urgencyIndex}}" bindchange="urgencyChange"><view class="select-box" hover-class="tap-surface"><text>{{urgencyOptions[urgencyIndex]}}</text><text class="select-label">选择</text></view></picker></view><view wx:if="{{urgencyIndex === 1 || urgencyIndex === 2}}" class="switch-row"><text class="grow">使用比赛模拟急需证明</text><switch checked="{{evidence}}" bindchange="evidenceChange" color="#096C9C"/></view><view class="field"><text class="field-label">未及时入库的风险</text><picker range="{{riskOptions}}" value="{{riskIndex}}" bindchange="riskChange"><view class="select-box" hover-class="tap-surface"><text>{{riskOptions[riskIndex]}}</text><text class="select-label">选择</text></view></picker></view></view>
    <view class="submit-area"><view wx:if="{{formError}}" class="field-error">{{formError}}</view><button class="primary" hover-class="press" form-type="submit" loading="{{busy}}" disabled="{{busy || !ready}}">{{busy ? '正在提交预约' : '提交并查看分配方案'}}<view wx:if="{{!busy}}" class="round-icon"><image src="/assets/icons/arrow-white.png"/></view></button><view class="demo-foot">仅模拟预约，不产生实际仓储合同<br/>请使用虚构资料，勿填写患者信息</view></view>
  </form>
</view>
