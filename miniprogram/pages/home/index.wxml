<view class="page">
  <view class="brand-row"><image class="brand-logo" src="/assets/brand/logo.png" mode="aspectFit"/><view class="grow"><view class="brand-title">渝冷智享</view><view class="brand-sub">重庆国际生物城冷链共享</view></view></view>
  <view wx:if="{{loadError}}" class="load-error"><view>{{loadError}}</view><button class="secondary compact" hover-class="press" bindtap="refresh">重新加载</button></view>
  <view wx:if="{{!ready && !loadError}}" class="panel"><view class="skeleton short"/><view class="skeleton large"/><view class="skeleton short"/><view class="skeleton"/></view>
  <block wx:if="{{ready}}">
    <view class="enterprise row"><view class="grow"><view class="enterprise-name">{{selected.name}}</view><view class="enterprise-meta">贡献积分 {{selected.points}}　保底 {{selected.guarantee}}m³</view></view><button class="secondary mini" hover-class="press" bindtap="switchCompany"><image class="icon icon-s" src="/assets/icons/swap.png"/>切换</button></view>
    <view class="surface-frame"><view class="surface-inner"><view class="row"><view class="service-copy"><view class="service-title">预约冷库</view><view class="service-desc">选择温区与时段<br/>查看可解释的分配方案</view></view><view class="service-art"><image src="/assets/icons/warehouse.png" mode="aspectFit"/></view></view><view class="service-actions"><button class="primary" hover-class="press" bindtap="book">新建预约<view class="round-icon"><image src="/assets/icons/plus-white.png"/></view></button><button class="secondary" hover-class="press" bindtap="resources">查看资源池</button></view></view></view>
    <view class="quick-row"><button class="quick-entry" hover-class="press" bindtap="orders"><view><view class="quick-title">我的预约</view><view class="quick-sub">{{pendingCount}}项待处理</view></view><image class="icon" src="/assets/icons/orders-active.png"/></button><button class="quick-entry" hover-class="press" bindtap="support"><view><view class="quick-title">应急协作</view><view class="quick-sub">{{emergencyCount ? emergencyCount + '项待保障' : '查看协作订单'}}</view></view><image class="icon" src="/assets/icons/support.png"/></button></view>
    <view class="section-head"><text class="section-title">进行中预约</text><button class="secondary mini" hover-class="press" bindtap="orders">全部订单</button></view>
    <view wx:for="{{activeOrders}}" wx:key="id" class="order-card"><view class="row"><text class="order-id">{{item.id}}</text><text class="tag {{item.tone}}">{{item.statusText}}</text></view><view class="order-details"><view><view class="order-key number">{{item.allocated}}<text class="unit">/ {{item.volume}}m³</text></view><view class="order-summary">获配库容</view></view><view class="order-temp"><image class="icon icon-s" src="/assets/icons/snow.png"/>{{item.temp}}</view></view><view class="order-bottom"><view class="small muted">{{item.dateLabel}}入库<br/>存储{{item.days}}天</view><button class="secondary compact" hover-class="press" data-id="{{item.id}}" bindtap="detail">{{item.nextAction}}<view class="round-icon"><image src="/assets/icons/arrow.png"/></view></button></view></view>
    <view wx:if="{{!activeOrders.length}}" class="panel empty"><image class="empty-icon" src="/assets/icons/inbox.png"/><view class="empty-title">还没有进行中的预约</view><view class="empty-copy">提交需求后，在这里查看分配结果和入库进度。</view><button class="outline compact" hover-class="press" bindtap="book">预约一笔冷库需求</button></view>
    <view class="section-head"><text class="section-title">共享库容</text><text class="section-note">{{window.start}}</text></view>
    <view class="list"><view class="capacity-row"><view class="capacity-copy"><view class="icon-well"><image class="icon" src="/assets/icons/warehouse.png"/></view><view><view class="list-title">冷藏库 2–8℃</view><view class="list-note">总计{{coldTotal}}m³</view></view></view><view class="capacity-value number">{{availableCold}}<text class="unit">m³可用</text></view></view><view class="capacity-row"><view class="capacity-copy"><view class="icon-well teal"><image class="icon" src="/assets/icons/snow.png"/></view><view><view class="list-title">冷冻库 −20℃</view><view class="list-note">总计{{frozenTotal}}m³</view></view></view><view class="capacity-value number">{{availableFrozen}}<text class="unit">m³可用</text></view></view></view>
    <view class="inline-copy">查询至{{window.end}}，结束日不占用库容。</view>
    <view class="case-entry"><view class="row"><view class="grow"><view class="case-title">旺季资源争用案例</view><view class="case-description">6家企业申请，共享冷藏库容500m³</view></view><image class="icon" src="/assets/icons/shield.png"/></view><button class="outline space" hover-class="press" loading="{{busy}}" disabled="{{busy}}" bindtap="runCase">{{hasOrders ? '重新演示六企业案例' : '运行六企业案例'}}</button></view>
  </block>
  <view class="demo-foot">企业、资源与订单均为模拟数据<br/>{{mode === 'local' ? '当前数据保存在本机' : '当前为独立云端演示工作区'}}</view>
</view>
