<view class="page">
  <view class="page-head"><view class="row"><text class="page-title">订单与协作</text><text class="demo-badge">模拟订单</text></view><view class="page-sub">{{selected.name || '加载企业信息中'}}</view></view>
  <view class="scope-buttons"><button class="scope-button {{scope === 'mine' ? 'selected' : ''}}" hover-class="press" data-value="mine" bindtap="scope">我的预约</button><button class="scope-button {{scope === 'all' ? 'selected' : ''}}" hover-class="press" data-value="all" bindtap="scope">全部企业案例</button></view>
  <view class="filter-scroll"><button class="filter-button {{filter === 'all' ? 'selected' : ''}}" data-value="all" bindtap="filter">全部</button><button class="filter-button {{filter === 'pending' ? 'selected' : ''}}" data-value="pending" bindtap="filter">待处理</button><button class="filter-button {{filter === 'stored' ? 'selected' : ''}}" data-value="stored" bindtap="filter">存储与运输</button><button class="filter-button {{filter === 'ended' ? 'selected' : ''}}" data-value="ended" bindtap="filter">已结束</button></view>
  <view wx:if="{{filter === 'support'}}" class="filter-info"><text>正在查看应急协作需求</text><button class="secondary mini" bindtap="clearFilter">查看全部订单</button></view>
  <view wx:if="{{loadError}}" class="load-error"><text>{{loadError}}</text><button class="secondary compact" bindtap="refresh">重新加载</button></view><view wx:if="{{!ready && !loadError}}" class="panel"><view class="skeleton"/><view class="skeleton large"/></view>
  <block wx:if="{{ready}}">
    <view wx:if="{{supportRequests.length}}"><view class="section-head"><text class="section-title">需要我响应的协作</text><text class="tag amber">{{supportRequests.length}}项</text></view><view wx:for="{{supportRequests}}" wx:key="id" class="support-card"><view class="row"><text class="list-title">{{item.companyName}}</text><text class="tag amber">高风险待保障</text></view><view class="order-key number space">{{item.remaining}}<text class="unit">m³尚未满足</text></view><view class="list-note">{{item.temp}} / {{item.start}}起 / {{item.days}}天</view><button wx:for="{{item.candidates}}" wx:for-item="resource" wx:key="id" class="secondary" data-id="{{item.id}}" data-resource="{{resource.id}}" bindtap="accept" loading="{{busy}}" disabled="{{busy}}">使用{{resource.name}}响应</button></view></view>
    <view wx:for="{{displayed}}" wx:key="id" class="order-card"><view class="row"><text class="list-title grow">{{item.companyName}}</text><text class="tag {{item.tone}}">{{item.statusText}}</text></view><view class="order-id space">{{item.id}}</view><view class="order-details"><view><view class="order-key number">{{item.allocated}}<text class="unit">/ {{item.volume}}m³</text></view><view class="order-summary">获配库容</view></view><view class="order-temp"><image class="icon icon-s" src="/assets/icons/snow.png"/>{{item.temp}}</view></view><view class="order-bottom"><view class="small muted">{{item.dateLabel}}入库<br/>存储{{item.days}}天</view><button class="secondary compact" hover-class="press" data-id="{{item.id}}" bindtap="detail">{{item.nextAction}}<view class="round-icon"><image src="/assets/icons/arrow.png"/></view></button></view></view>
    <view wx:if="{{!displayed.length}}" class="panel empty"><image class="empty-icon" src="/assets/icons/inbox.png"/><view class="empty-title">{{filter === 'all' ? '还没有预约记录' : '没有符合条件的订单'}}</view><view class="empty-copy">{{filter === 'all' ? '提交冷库需求，查看评分分配并跟进入库。' : '可以切换状态筛选，查看其他预约。'}}</view><button wx:if="{{filter === 'all'}}" class="outline compact" hover-class="press" bindtap="book">新建预约</button><button wx:else class="outline compact" hover-class="press" bindtap="clearFilter">查看全部状态</button></view>
  </block>
  <view class="demo-foot">仅展示当前工作区的模拟记录</view>
</view>
