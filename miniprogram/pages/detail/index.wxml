<view class="page">
  <button wx:if="{{ready}}" class="outline space" bindtap="trace">查看模拟溯源档案与告警</button>
  <view wx:if="{{loadError}}" class="load-error"><text>{{loadError}}</text><button class="secondary compact" bindtap="refresh">重新加载订单</button></view><view wx:if="{{!ready && !loadError}}" class="panel"><view class="skeleton short"/><view class="skeleton large"/><view class="skeleton"/></view>
  <block wx:if="{{ready}}">
    <view class="page-head"><view class="detail-status"><view class="status-symbol"><image class="icon" src="/assets/icons/orders-active.png"/></view><view class="grow"><view class="detail-status-title">{{o.statusText}}</view><view class="page-sub">{{o.companyName}}</view></view><text class="demo-badge">模拟订单</text></view><view class="order-id space">{{o.id}}</view></view>
    <view wx:if="{{!o.ended}}" class="stepper"><view wx:for="{{o.steps}}" wx:key="index" class="step {{item.active ? 'active' : ''}} {{item.done ? 'done' : ''}}"><view class="step-dot"/>{{item.name}}</view></view>
    <view wx:if="{{!own}}" class="notice info"><view>这是其他模拟企业的预约，切换身份后可操作。</view><button class="outline compact" hover-class="press" disabled="{{busy}}" bindtap="switchCompany">切换到该企业</button></view>
    <view class="surface-frame space"><view class="surface-inner"><view class="row"><text class="small muted">已分配库容</text><text class="tag blue">{{o.temp}}</text></view><view class="summary-volume number">{{o.allocated}}<text class="summary-total">/ {{o.volume}}m³</text></view><view class="divider"/><view class="key-value"><text class="key-label">存储时段</text><text class="value">{{o.start}}<br/>至{{o.end}}，共{{o.days}}天</text></view><view class="key-value"><text class="key-label">费用预估</text><text class="value number">¥{{o.fee}}</text></view></view></view>
    <view wx:if="{{own && (canConfirm || canEmergency)}}" class="detail-actions"><button wx:if="{{canConfirm}}" class="primary" hover-class="press" disabled="{{busy}}" loading="{{busy}}" bindtap="confirm">{{o.remaining > 0 ? '确认已获配部分' : '确认预约'}}</button><button wx:if="{{canEmergency}}" class="secondary" hover-class="press" disabled="{{busy}}" bindtap="emergency">申请应急协作</button></view>
    <view wx:if="{{o.remaining > 0}}" class="notice space"><view>尚有{{o.remaining}}m³未满足</view><view wx:if="{{o.status === 'emergency_pending'}}" class="small space">等待供给方确认，可切换供给企业响应请求。</view><view wx:else class="small space">可调整日期重新申请，其他时段需要重新查询。</view><button wx:if="{{o.status === 'emergency_pending'}}" class="outline compact" hover-class="press" disabled="{{busy}}" bindtap="openSupply">切换供给方并处理</button></view>
    <view wx:if="{{o.allocations.length}}"><view class="section-head"><text class="section-title">已分配库区</text></view><view class="list"><view wx:for="{{o.allocations}}" wx:key="resourceId" class="list-row row"><text class="list-title grow">{{item.name}}</text><text class="number">{{item.volume}}m³</text></view></view><view wx:if="{{o.emergency}}" class="inline-copy">应急积分预计{{o.emergency.expectedPoints}}，{{o.emergency.settled ? '已计入供给方' : '全部履约完成后计入'}}；模拟补偿¥{{o.emergency.compensation}}。</view></view>
    <view wx:if="{{own && o.status === 'confirmed'}}"><view class="section-head"><text class="section-title">入库登记</text></view><view class="panel"><view class="row"><text class="small muted">模拟入库码</text><text class="number">{{o.id}}</text></view><button class="primary space" hover-class="press" bindtap="scan" disabled="{{busy}}">扫码登记入库</button><button class="secondary space" hover-class="press" bindtap="demoCheckIn" disabled="{{busy}}">使用模拟入库码</button><view class="inline-copy">二维码内容需与订单号一致。</view></view></view>
    <view wx:if="{{monitoring}}"><view class="section-head"><text class="section-title">温度记录</text><text class="section-note">固定模拟样本</text></view><view class="panel"><view class="row"><view><view class="small muted">最近样本温度</view><view class="temperature-value number">{{currentTemperature}}℃</view></view><view class="icon-well"><image class="icon" src="/assets/icons/snow.png"/></view></view><view class="temperature-bars"><view wx:for="{{temperature}}" wx:key="index" class="temperature-bar" style="height:{{item.height}}%"/></view><view class="row small muted"><text>样本1</text><text>样本12</text></view><view class="inline-copy">按{{o.temp === '2-8℃' ? '2～8℃' : '−22～−18℃'}}区间示意，未接实时传感器。</view></view></view>
    <view wx:if="{{own && o.status === 'stored'}}" class="space"><button class="primary" hover-class="press" bindtap="toggleDispatch">{{showDispatch ? '收起配车表单' : '申请出库配车'}} · 待运{{o.unshipped}}m³</button><form wx:if="{{showDispatch}}" class="form-section space" bindsubmit="dispatch"><view class="form-section-title">本批次出库</view><view class="form-pair"><view class="field"><text class="field-label">体积 / m³</text><input class="input" name="volume" type="digit" value="{{defaultVolume}}"/></view><view class="field"><text class="field-label">重量 / 吨</text><input class="input" name="tons" type="digit" value="1"/></view></view><view class="field"><text class="field-label">最晚到达 / 多少分钟后</text><input class="input" name="minutes" type="number" value="120"/></view><view class="inline-copy">同时校验温区、体积、重量与时限。大批量可分批出库。</view><button class="primary space" hover-class="press" form-type="submit" loading="{{busy}}" disabled="{{busy}}">匹配车辆</button></form></view>
    <view wx:if="{{o.transport}}"><view class="section-head"><text class="section-title">运输安排</text><text class="section-note">模拟路线与时效</text></view><view class="panel"><view class="row"><view class="row grow"><view class="icon-well"><image class="icon" src="/assets/icons/truck.png"/></view><view class="grow"><view class="list-title">{{o.transport.name}}</view><view class="list-note">{{o.transport.cargoVolume}}m³ / {{o.transport.cargoTons}}吨</view></view></view><text class="tag blue">{{o.transport.matchScore}}分</text></view><view class="divider"/><view class="route"><view class="route-point"/><text>共享冷库</text><view class="route-line"/><view class="route-point"/><text>江北机场</text></view><view class="inline-copy">模拟耗时{{o.transport.minutes}}分钟，未接实时路况。</view><view class="divider"/><view class="key-value"><text class="key-label">模拟运费</text><text>¥{{o.transport.fee}}</text></view><view class="key-value"><text class="key-label">供给方 / 平台</text><text class="value">¥{{o.transport.providerIncome}} / ¥{{o.transport.platformIncome}}</text></view><button wx:if="{{own && o.status === 'shipping'}}" class="primary space" hover-class="press" bindtap="complete" disabled="{{busy}}">完成本批模拟运输</button></view></view>
    <view class="section-head"><text class="section-title">评分与分配依据</text><text class="section-note">同批次第{{o.rank}}名</text></view><view class="panel"><view class="row"><view><view class="small muted">综合得分</view><view class="score-total number">{{o.score.total}}<text class="unit">/ 100</text></view></view><button class="secondary compact" hover-class="press" bindtap="toggleScore">{{showScore ? '收起明细' : '查看明细'}}</button></view><block wx:if="{{showScore}}"><view wx:for="{{o.scoreRows}}" wx:key="key" class="score-row"><text class="grow">{{item.name}}</text><text class="score-formula">{{item.raw}} × {{item.weight}}%</text><text class="score-result number">{{item.weighted}}</text></view><view class="inline-copy">保底预留独立于评分；贡献分按本批次最高积分归一化，总分加权后四舍五入。</view><view class="divider"/><view wx:for="{{o.reasons}}" wx:key="*this" class="condition"><image class="icon" src="/assets/icons/check.png"/><text class="grow">{{item}}</text></view><view class="inline-copy">资质与隔离条件为模拟配置，不代表真实核验。</view></block></view>
    <view class="section-head"><text class="section-title">操作记录</text><text class="section-note">日志未上链</text></view><view class="panel"><view class="timeline"><view wx:for="{{history}}" wx:key="index" class="timeline-item"><view class="timeline-copy">{{item.message}}</view><view class="timeline-time">{{item.time}}</view></view></view></view>
    <view wx:if="{{o.appeal}}" class="notice space"><view>{{o.appeal.status}}</view><view class="small space">{{o.appeal.reason}}</view><view class="inline-copy">模拟复核期限{{appealDue}}，本版仅记录申诉。</view></view>
    <view wx:if="{{own && !o.ended}}" class="detail-actions"><button wx:if="{{!o.appeal}}" class="outline" hover-class="press" bindtap="appeal" disabled="{{busy}}">提出申诉</button><button wx:if="{{canCancel}}" class="danger" hover-class="press" bindtap="cancel" disabled="{{busy}}">取消预约</button></view>
    <view class="demo-foot">本订单不产生真实仓储、运输或支付服务</view>
  </block>
</view>
