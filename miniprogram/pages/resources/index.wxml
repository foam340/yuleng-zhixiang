<view class="page">
  <view class="page-head"><view class="row"><text class="page-title">资源池</text><text class="demo-badge">模拟资源</text></view><view class="page-sub">按温区、时段查询共享库容</view></view>
  <view class="query-panel"><view class="query-fields"><view class="query-date"><view class="query-label">计划入库日期</view><picker mode="date" value="{{start}}" bindchange="dateChange"><view class="query-value" hover-class="tap-surface"><text>{{start}}</text><image class="icon icon-s" src="/assets/icons/calendar-active.png"/></view></picker></view><view><view class="query-label">存储天数</view><input class="query-days" type="number" value="{{days}}" bindblur="daysChange"/></view></view></view>
  <view class="filter-scroll"><button class="filter-button {{filter === 'all' ? 'selected' : ''}}" hover-class="press" data-value="all" bindtap="filter">全部温区</button><button class="filter-button {{filter === '2-8℃' ? 'selected' : ''}}" hover-class="press" data-value="2-8℃" bindtap="filter">冷藏 2–8℃</button><button class="filter-button {{filter === '-20℃' ? 'selected' : ''}}" hover-class="press" data-value="-20℃" bindtap="filter">冷冻 −20℃</button></view>
  <view wx:if="{{loadError}}" class="load-error"><text>{{loadError}}</text><button class="secondary compact" bindtap="refresh">重试查询</button></view><view wx:if="{{!ready && !loadError}}" class="panel"><view class="skeleton large"/><view class="skeleton"/><view class="skeleton short"/></view>
  <block wx:if="{{ready}}">
    <view wx:for="{{filtered}}" wx:key="id" class="resource-card"><view class="resource-inner"><view class="row"><view class="row grow"><view class="icon-well {{item.cold ? '' : 'teal'}}"><image class="icon" src="{{item.cold ? '/assets/icons/warehouse.png' : '/assets/icons/snow.png'}}"/></view><view class="grow"><view class="resource-name">{{item.name}}</view><text class="tag {{item.pool ? 'blue' : 'amber'}}">{{item.pool ? item.temp : '应急协作库'}}</text></view></view></view><view class="resource-location">{{item.location}}</view><view class="resource-stats"><view class="resource-stat"><view class="resource-number number">{{item.available}}<text class="unit">m³</text></view><view class="resource-label">可用 / 总计{{item.capacity}}m³</view></view><view class="resource-stat"><view class="resource-number number">{{item.price}}<text class="unit">元</text></view><view class="resource-label">每m³每天</view></view></view><view class="capacity-track"><view class="capacity-fill {{item.cold ? '' : 'teal'}}" style="width:{{item.freePct}}%"/></view><view class="resource-bottom"><view class="resource-note grow">{{item.ownerName}}<br/>{{item.isolated ? '设有隔离储位' : '普通储位'}}</view><button wx:if="{{item.pool}}" class="secondary compact" hover-class="press" data-id="{{item.id}}" bindtap="book">{{item.tight ? '申请候补' : '预约冷库'}}</button><button wx:else class="secondary compact" hover-class="press" bindtap="openOrders">查看协作</button></view></view></view>
    <view wx:if="{{!filtered.length}}" class="panel empty"><image class="empty-icon" src="/assets/icons/inbox.png"/><view class="empty-title">当前没有匹配资源</view><view class="empty-copy">试试其他温区，或发布企业的闲置冷库。</view><button class="outline compact" data-value="all" bindtap="filter">查看全部温区</button></view>
    <view class="section-head"><text class="section-title">共享车辆</text><button class="secondary mini" hover-class="press" bindtap="transportOrders">去订单配车</button></view><view class="list"><view wx:for="{{vehicles}}" wx:key="id" class="list-row vehicle-row"><view class="icon-well"><image class="icon" src="/assets/icons/truck.png"/></view><view class="grow"><view class="row"><text class="list-title">{{item.name}}</text><text class="tag gray">{{item.temp}}</text></view><view class="list-note">{{item.tons}}吨 / {{item.volume}}m³</view><view class="list-note">模拟到达耗时{{item.minutes}}分钟</view></view></view></view>
  </block>
  <button class="outline space" hover-class="press" bindtap="togglePublish">{{showPublish ? '收起发布表单' : '发布我的闲置冷库'}}<image class="icon icon-s" src="/assets/icons/plus.png"/></button>
  <form wx:if="{{showPublish}}" class="form-section publish-panel" bindsubmit="publish"><view class="form-section-title">发布模拟冷库</view><view class="field"><text class="field-label">投放起始日 / 天数</text><input class="input" name="start" value="2026-11-02"/><input class="input space" name="days" value="3" type="number"/></view><view class="field-hint">投放时按库容×天数×温区系数产生积分；仅投放时段内可分配。</view><view class="field"><text class="field-label">资源名称</text><input class="input" name="name" maxlength="30" placeholder="填写库区名称"/></view><view class="field"><text class="field-label">温区</text><picker range="{{tempOptions}}" value="{{publishTemp}}" bindchange="tempChange"><view class="select-box"><text>{{tempOptions[publishTemp]}}</text><text class="select-label">选择</text></view></picker></view><view class="form-pair"><view class="field"><text class="field-label">库容 / m³</text><input class="input" name="capacity" type="digit" placeholder="例如120"/></view><view class="field"><text class="field-label">单价 / 元</text><input class="input" name="price" type="digit" placeholder="例如6"/></view></view><view class="switch-row"><text>独立隔离储位</text><switch checked="{{isolated}}" bindchange="isolationChange" color="#096C9C"/></view><view class="switch-row"><text>仅用于应急协作</text><switch checked="{{emergency}}" bindchange="emergencyChange" color="#096C9C"/></view><button class="primary" hover-class="press" form-type="submit" loading="{{busy}}" disabled="{{busy}}">发布模拟资源</button></form>
  <view class="demo-foot">资源、价格、资质标记与车辆时效均为模拟配置</view>
</view>
