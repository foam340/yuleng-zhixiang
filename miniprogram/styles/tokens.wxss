page{
  --bg:#F3F7FB;--surface:#FFFFFF;--ink:#153348;--muted:#586F82;
  --blue:#096C9C;--blue-deep:#07517A;--blue-soft:#E8F3FA;
  --teal:#147D83;--teal-soft:#E7F4F2;--amber:#966321;--amber-soft:#FFF3DF;
  --line:#E4EDF4;--danger:#A75540;--ease:cubic-bezier(.22,.8,.24,1);
  background:var(--bg);color:var(--ink);font-family:"PingFang SC","Microsoft YaHei",sans-serif;font-size:28rpx;line-height:1.55;
}
view,text,image,button,input,textarea,picker,scroll-view{box-sizing:border-box;min-width:0}
/* v2原生button有独立的宽度、内边距和行高；组件样式必须显式覆盖。 */
.page button{display:flex;align-items:center;justify-content:center;width:auto;margin:0;padding:0;border:0;font-family:inherit;font-weight:500;line-height:1.4;text-align:center}.page button[class]{margin:0}button::after{border:0}button[disabled]{opacity:.45}
input,textarea{font-family:inherit}
.page{padding:28rpx 32rpx calc(46rpx + env(safe-area-inset-bottom));min-height:100vh}
.row{display:flex;align-items:center;justify-content:space-between;gap:20rpx}.grow{flex:1;min-width:0}.wrap{flex-wrap:wrap}.muted{color:var(--muted)}.small{font-size:24rpx}.tiny{font-size:22rpx}.space{margin-top:20rpx}.center{text-align:center}
.brand-row{display:flex;align-items:center;gap:18rpx;margin:2rpx 0 28rpx}.brand-logo{width:76rpx;height:76rpx;border-radius:22rpx;flex-shrink:0}.brand-title{font-size:38rpx;font-weight:650;line-height:1.25;letter-spacing:1rpx}.brand-sub{font-size:22rpx;color:var(--muted);margin-top:6rpx}.demo-badge{font-size:21rpx;color:#536C7E;background:#E6EEF5;padding:8rpx 15rpx;border-radius:999rpx;white-space:nowrap;flex-shrink:0}
.page-head{margin:4rpx 0 28rpx}.page-title{font-size:42rpx;font-weight:650;line-height:1.35}.page-sub{font-size:24rpx;color:var(--muted);margin-top:10rpx}.section-head{display:flex;align-items:center;justify-content:space-between;gap:20rpx;margin:34rpx 0 18rpx}.section-title{font-size:31rpx;font-weight:600}.section-note{font-size:22rpx;color:var(--muted)}
.icon{display:block;width:40rpx;height:40rpx;flex-shrink:0}.icon-s{width:30rpx;height:30rpx}.icon-lg{width:64rpx;height:64rpx}.icon-well{display:flex;align-items:center;justify-content:center;width:72rpx;height:72rpx;background:var(--blue-soft);border-radius:22rpx;flex-shrink:0}.icon-well.teal{background:var(--teal-soft)}
.page .primary,.page .secondary,.page .outline,.page .danger{display:flex;align-items:center;justify-content:center;gap:16rpx;width:100%;min-height:94rpx;padding:20rpx 30rpx;border-radius:999rpx;font-size:28rpx;line-height:1.4;transition:transform 150ms var(--ease),opacity 150ms var(--ease);white-space:normal}
.page .primary{background:var(--blue);color:#FFF;box-shadow:0 8rpx 22rpx rgba(9,108,156,.12)}.page .secondary{background:var(--blue-soft);color:var(--blue-deep);box-shadow:inset 0 0 0 1rpx rgba(9,108,156,.1)}.page .outline{background:#FFF;color:var(--blue-deep);box-shadow:inset 0 0 0 2rpx #C5DCEB}.page .danger{background:#F8EEEA;color:var(--danger)}.page .compact{width:auto;min-height:76rpx;padding:16rpx 24rpx;font-size:24rpx;flex-shrink:0}.page .mini{width:auto;min-height:72rpx;padding:14rpx 20rpx;font-size:23rpx;flex-shrink:0}.round-icon{display:flex;align-items:center;justify-content:center;width:42rpx;height:42rpx;border-radius:50%;background:rgba(255,255,255,.2);flex-shrink:0}.secondary .round-icon,.outline .round-icon{background:#FFF}.round-icon image{width:26rpx;height:26rpx}.press{transform:scale(.98);opacity:.88}.tap-surface{background:#EDF5FA!important}
.panel{background:#FFF;border-radius:26rpx;padding:28rpx;box-shadow:0 7rpx 24rpx rgba(28,72,105,.035)}.surface-frame{padding:7rpx;border-radius:32rpx;background:#E8F0F7;box-shadow:0 12rpx 30rpx rgba(21,51,72,.045)}.surface-inner{padding:30rpx;border-radius:25rpx;background:#FFF;box-shadow:inset 0 1rpx 0 rgba(255,255,255,.9)}.divider{height:1rpx;background:var(--line);margin:24rpx 0}.tag{display:inline-flex;align-items:center;justify-content:center;border-radius:8rpx;padding:6rpx 12rpx;font-size:22rpx;line-height:1.5;white-space:nowrap}.tag.blue{color:var(--blue-deep);background:var(--blue-soft)}.tag.teal{color:#126A70;background:var(--teal-soft)}.tag.amber{color:#87591F;background:var(--amber-soft)}.tag.gray{color:#526B7D;background:#EDF2F6}
.list{background:#FFF;border-radius:25rpx;padding:0 26rpx}.list-row{padding:26rpx 0;border-bottom:1rpx solid var(--line)}.list-row:last-child{border-bottom:0}.list-title{font-size:27rpx;font-weight:500}.list-note{font-size:23rpx;color:var(--muted);margin-top:8rpx}.action-row{display:flex;align-items:center;justify-content:space-between;gap:20rpx;margin-top:24rpx}.number{font-family:"DIN Alternate","Bahnschrift","PingFang SC",sans-serif;font-variant-numeric:tabular-nums}.unit{font-size:23rpx;font-weight:400;color:var(--muted);margin-left:7rpx}
.empty{padding:36rpx 24rpx;text-align:center}.empty-icon{width:62rpx;height:62rpx;margin:0 auto 20rpx;opacity:.75}.empty-title{font-size:28rpx;font-weight:500}.empty-copy{font-size:24rpx;color:var(--muted);margin:12rpx auto 22rpx;line-height:1.65;max-width:470rpx}.page .empty .compact{display:inline-flex}.load-error{background:#FFF7E9;color:#77531F;border-radius:22rpx;padding:24rpx;margin:22rpx 0}.page .load-error .secondary{margin-top:18rpx}.loading-state{padding:58rpx 28rpx;text-align:center;color:var(--muted)}.skeleton{height:24rpx;border-radius:8rpx;background:#E4EDF4;margin:18rpx 0}.skeleton.large{height:180rpx;border-radius:24rpx}.skeleton.short{width:58%}.field-error{color:#964E3A;background:#F9EEE8;border-radius:16rpx;padding:20rpx 24rpx;font-size:25rpx;margin:18rpx 0}
.demo-foot{font-size:22rpx;color:#586F82;text-align:center;margin-top:30rpx;line-height:1.7}.notice{padding:24rpx;border-radius:22rpx;background:var(--amber-soft);color:#805F2E;font-size:25rpx;line-height:1.7}.page .notice .compact{margin-top:20rpx}.notice.info{background:var(--blue-soft);color:#3E677F}.inline-copy{font-size:23rpx;color:var(--muted);line-height:1.7;margin-top:16rpx}
@media(prefers-reduced-motion:reduce){.page .primary,.page .secondary,.page .outline,.page .danger{transition:none}.press{transform:none}}
